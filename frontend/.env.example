REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_SUPABASE_URL=https://xxxxx.supabase.co
# Chiave pubblica moderna per il browser; la legacy anon resta fallback.
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
REACT_APP_SUPABASE_ANON_KEY=eyJ...
# Se configurate, le sessioni Supabase Auth vengono inviate al backend come Bearer JWT.
# Gli account legacy restano disponibili durante la migrazione dual-mode.
# Produzione: il tenant interno resta fisso sul dominio gbconstruction.it
REACT_APP_DEFAULT_TENANT_SLUG=gbconstruction
# Abilitare solo dopo il GO del ground-truth AI Architect.
REACT_APP_AI_ARCHITECT_PUBLIC_ENABLED=false
