# Backend
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@gbconstruction.it
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Amministratore GB Construction
# Mai attivare in produzione: inserisce lead e cantieri dimostrativi solo su DB vuoto.
ENABLE_DEMO_SEED=false
# Produzione: https://gbconstruction.it,https://www.gbconstruction.it,https://app.gbconstruction.it
CORS_ORIGINS=http://localhost:3000
# Produzione: https://app.gbconstruction.it
APP_PUBLIC_URL=http://localhost:3000

# Supabase: unico database applicativo, con accesso tenant-scoped
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Compatibilita con le chiavi legacy, se ancora abilitate nel progetto
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Connection string Postgres (una delle due basta; CONNECTION_STRING_SUPABASE ha priorità)
CONNECTION_STRING_SUPABASE=postgresql://postgres:...@db.xxxxx.supabase.co:5432/postgres
# Alias compatibile con installazioni esistenti
CONNECT_STRINGSUPABASE=
SUPABASE_DB_URL=postgresql://postgres:...@db.xxxxx.supabase.co:5432/postgres
SUPABASE_JWKS_URL=https://xxxxx.supabase.co/auth/v1/.well-known/jwks.json
# Produzione: gbconstruction.it (frontend) e api.gbconstruction.it (backend)
DEFAULT_TENANT_SLUG=gbconstruction

# Email automatiche lead/preventivi.
# Produzione Railway Hobby: Resend via HTTPS ha priorita su SMTP.
RESEND_API_KEY=
# Alias storico supportato: API_RESEND=
RESEND_TIMEOUT_SECONDS=20
MAIL_FROM_EMAIL=info@gbconstruction.it
MAIL_FROM_NAME=GB Construction
LEAD_NOTIFICATION_EMAIL=info@gbconstruction.it
MAIL_LOGO_URL=https://app.gbconstruction.it/brand/gb-logo.png

# Fallback locale/hosting con SMTP SSL/TLS cPanel.
SMTP_HOST=mail.gbconstruction.it
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_USERNAME=info@gbconstruction.it
SMTP_PASSWORD=

# Deployment
RAILWAY_API_TOKEN=

# Test E2E remoti (disabilitati per default; non inserire segreti nel repository)
GB_LIVE_E2E=0
GB_E2E_BASE_URL=https://api.gbconstruction.it
GB_E2E_ADMIN_EMAIL=
GB_E2E_ADMIN_PASSWORD=
GB_E2E_STAFF_EMAIL=
GB_E2E_STAFF_PASSWORD=

# Optional AI / integrations
STITCH_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
FAL_KEY=
AI_RENDER_MAX_ROOMS_PUBLIC=2
AI_RENDER_MAX_ROOMS_STAFF=4
AI_ARCHITECT_UPLOAD_MAX_MB=20
AUTH_LOGIN_MAX_PER_15_MIN=10
PUBLIC_LEAD_MAX_PER_HOUR=10
PUBLIC_BOOKING_MAX_PER_HOUR=10
AI_MONTHLY_INCLUDED_CREDITS=30000
AI_CREDITS_LOW_THRESHOLD=10000
AI_CREDIT_PACK_EXPIRY_MONTHS=12
AI_BASE_CREDIT_PACK_ENABLED=true
AI_BASE_CREDIT_PACK_CREDITS=20000
AI_CREDITS_UNLIMITED_EMAILS=
QUOTE_UNLIMITED_EMAILS=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Google Calendar aziendale - sopralluoghi (OAuth dell'account indicato).
# Attivare solo dopo aver valorizzato tutte le credenziali protette su Railway.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=gbconstructionsrls@gmail.com
GOOGLE_CALENDAR_TIMEZONE=Europe/Rome
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1244875055383159
WHATSAPP_BUSINESS_ACCOUNT_ID=3075902775936600
WHATSAPP_PAYMENT_TEMPLATE=promemoria_pagamento_cantiere
